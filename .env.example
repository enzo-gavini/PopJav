# ============================================================================
# PopJav - Exemple de configuration.
# Copiez ce fichier en `.env` puis renseignez vos valeurs :  cp .env.example .env
# Le fichier `.env` ne doit JAMAIS etre commite (il est ignore par git).
# ============================================================================

# ===== Service discovery (Consul) =====
CONSUL_HOST=localhost
CONSUL_PORT=8500

# ===== JWT =====
# Secret encode en Base64, min. 256 bits pour HS256.
# Generer une valeur :  openssl rand -base64 48
JWT_SECRET=REMPLACER_PAR_UN_SECRET_BASE64
# Duree de validite du token en millisecondes (ex. 86400000 = 24h)
JWT_EXPIRATION=14400000

# ===== Ports des services =====
GATEWAY_PORT=8080
AUTH_SERVICE_PORT=8081
CONTENT_SERVICE_PORT=8082
QUIZ_SERVICE_PORT=8083
COMMENT_SERVICE_PORT=8084
UI_SERVICE_PORT=8085
PERSISTENCE_SERVICE_PORT=8086

# ===== PostgreSQL (persistence-service) =====
PERSISTENCE_DB_HOST=localhost
PERSISTENCE_DB_PORT=5432
PERSISTENCE_DB_NAME=popjav
PERSISTENCE_DB_USERNAME=popjav
PERSISTENCE_DB_PASSWORD=REMPLACER_PAR_UN_MOT_DE_PASSE

# ===== MongoDB (comment-service) =====
COMMENT_DB_HOST=localhost
COMMENT_DB_PORT=27017
COMMENT_DB_NAME=popjav_comments
COMMENT_DB_USERNAME=popjav
COMMENT_DB_PASSWORD=REMPLACER_PAR_UN_MOT_DE_PASSE
